{
  "id": "interact_chain",
  "name": "互动-三级接力",
  "description": "A评论→B回复A→C回复B，形成互动链",
  "version": "1.0",
  "platform": "douyin",
  "steps": [
    {"step_id": 1, "op": "goto_url",     "args": {"url": "@url"},        "pre": {}, "post": {}},
    {"step_id": 2, "op": "wait_watch",   "args": {"seconds": 5},        "pre": {}, "post": {}},
    {"step_id": 3, "op": "open_comments","args": {},                     "pre": {}, "post": {}},
    {"step_id": 4, "op": "post_comment", "args": {"text": "@comment_text"}, "pre": {}, "post": {}},
    {"step_id": 5, "op": "wait",         "args": {"seconds": 60},       "pre": {}, "post": {}},
    {"step_id": 6, "op": "reply_comment","args": {"text": "@reply_text"},   "pre": {}, "post": {}},
    {"step_id": 7, "op": "wait",         "args": {"seconds": 60},       "pre": {}, "post": {}},
    {"step_id": 8, "op": "reply_comment","args": {"text": "@second_reply_text"}, "pre": {}, "post": {}}
  ],
  "args_schema": {
    "url": {"type": "string", "required": true, "desc": "视频链接"},
    "comment_text": {"type": "string", "desc": "一级评论内容，支持@corpus"},
    "reply_text": {"type": "string", "desc": "二级回复内容"},
    "second_reply_text": {"type": "string", "desc": "三级回复内容"},
    "chain_position": {"type": "string", "enum": ["first", "reply", "second_reply"]}
  }
}
