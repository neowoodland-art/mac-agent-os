{
  "id": "douyin_nurture_v1",
  "name": "抖音养号（手机模式）",
  "version": "1.0.0",
  "platform": "douyin",
  "description": "搜索→浏览视频→点赞→收藏→切换→重复，使用手机模式操作",
  "entry_url": "https://www.douyin.com/",
  "device_mode": "mobile_tablet",
  "steps": [
    {
      "step_id": 1,
      "op": "goto_home",
      "args": {"activate_mobile": true},
      "pre": {"page_mode": ["unknown", "grid", "player", "search"]},
      "post": {"page_mode": "grid", "description": "首页已加载，手机模式已激活"},
      "verify": {"mode": "anchor", "anchor": "grid_page", "timeout": 20},
      "on_fail": "retry(2)",
      "wait_after": 5
    },
    {
      "step_id": 2,
      "op": "search",
      "args": {"keyword": "美食推荐"},
      "pre": {"page_mode": "grid"},
      "post": {"page_mode": "search", "description": "搜索结果已加载"},
      "verify": {"mode": "none"},
      "wait_after": 4
    },
    {
      "step_id": 3,
      "op": "open_video",
      "args": {},
      "pre": {"page_mode": ["grid", "search"]},
      "post": {"page_mode": "player", "description": "视频播放器已打开"},
      "verify": {"mode": "element", "selector": "video", "timeout": 10},
      "on_fail": "try_search",
      "wait_after": 4
    },
    {
      "step_id": 4,
      "op": "wait_watch",
      "args": {"seconds": 6},
      "pre": {"page_mode": "player"},
      "post": {"page_mode": "player"},
      "verify": {"mode": "none"},
      "wait_after": 0
    },
    {
      "step_id": 5,
      "op": "like",
      "args": {},
      "pre": {"page_mode": "player"},
      "post": {"page_mode": "player", "liked": true},
      "verify": {"mode": "element", "selector": "[data-e2e='video-player-digg']", "timeout": 10},
      "on_fail": "log",
      "wait_after": 3
    },
    {
      "step_id": 6,
      "op": "collect",
      "args": {},
      "pre": {"page_mode": "player"},
      "post": {"page_mode": "player", "collected": true},
      "verify": {"mode": "element", "selector": "[data-e2e='video-player-collect']", "timeout": 10},
      "on_fail": "log",
      "wait_after": 3
    },
    {
      "step_id": 7,
      "op": "next_video",
      "args": {"method": "auto"},
      "pre": {"page_mode": "player"},
      "post": {"page_mode": "player", "description": "已切换到下一个视频"},
      "verify": {"mode": "none"},
      "wait_after": 5
    },
    {
      "step_id": 8,
      "op": "like",
      "args": {},
      "pre": {"page_mode": "player"},
      "post": {"page_mode": "player", "liked": true},
      "verify": {"mode": "element", "selector": "[data-e2e='video-player-digg']", "timeout": 10},
      "on_fail": "log",
      "wait_after": 3
    }
  ]
}
