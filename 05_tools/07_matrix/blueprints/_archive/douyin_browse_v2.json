{
  "id": "douyin_browse_v2",
  "name": "抖音日常浏览（V2-原子操作版）",
  "platform": "douyin",
  "version": "2.0.0",
  "description": "从推荐页出发，浏览视频+随机点赞+收藏，基于 data-e2e 选择器",
  "entry_url": "https://www.douyin.com/",
  "entry_page": "recommend_feed",
  "steps": [
    {
      "step_id": 1, "op": "goto_home", "args": {},
      "wait_after": 3, "wait_jitter": 1, "retry": 2,
      "post_check": "is_on_feed"
    },
    {
      "step_id": 2, "op": "wait_watch", "args": {"seconds": 8},
      "wait_after": 0, "wait_jitter": 3
    },
    {
      "step_id": 3, "op": "like", "args": {"probability": 0.4},
      "wait_after": 1.5, "wait_jitter": 0.5,
      "post_check": "digg_state_changed"
    },
    {
      "step_id": 4, "op": "next_video", "args": {},
      "wait_after": 2, "wait_jitter": 0.5
    },
    {
      "step_id": 5, "op": "wait_watch", "args": {"seconds": 12},
      "wait_after": 0, "wait_jitter": 4
    },
    {
      "step_id": 6, "op": "collect", "args": {"probability": 0.15},
      "wait_after": 1, "wait_jitter": 0.5
    },
    {
      "step_id": 7, "op": "next_video", "args": {},
      "wait_after": 2, "wait_jitter": 0.5
    },
    {
      "step_id": 8, "op": "wait_watch", "args": {"seconds": 10},
      "wait_after": 0, "wait_jitter": 3
    },
    {
      "step_id": 9, "op": "like", "args": {"probability": 0.3},
      "wait_after": 1, "wait_jitter": 0.5
    },
    {
      "step_id": 10, "op": "next_video", "args": {},
      "wait_after": 2, "wait_jitter": 0.5
    },
    {
      "step_id": 11, "op": "wait_watch", "args": {"seconds": 15},
      "wait_after": 0, "wait_jitter": 5
    }
  ]
}
