{
  "id": "douyin_browse_v3",
  "name": "抖音日常浏览（V3-带验证锚点）",
  "platform": "douyin",
  "version": "3.0.0",
  "description": "从推荐页出发 → 打开视频 → 浏览+点赞+收藏 → 下一条",
  "entry_url": "https://www.douyin.com/",
  "entry_page": "home",
  "steps": [
    {
      "step_id": 1, "op": "goto_home",
      "args": {},
      "verify": {"mode": "anchor", "anchor": "grid_page", "timeout": 15},
      "on_fail": "retry(2)",
      "wait_after": 3
    },
    {
      "step_id": 2, "op": "open_video",
      "args": {},
      "verify": {"mode": "element", "selector": "video", "timeout": 10},
      "on_fail": "try_search",
      "wait_after": 3
    },
    {
      "step_id": 3, "op": "wait_watch",
      "args": {"seconds": 8},
      "verify": {"mode": "none"},
      "wait_after": 0
    },
    {
      "step_id": 4, "op": "like",
      "args": {},
      "verify": {"mode": "element", "selector": "[data-e2e='video-player-digg']", "timeout": 10},
      "on_fail": "skip",
      "wait_after": 1
    },
    {
      "step_id": 5, "op": "next_video",
      "args": {},
      "verify": {"mode": "none"},
      "wait_after": 2
    },
    {
      "step_id": 6, "op": "wait_watch",
      "args": {"seconds": 10},
      "wait_after": 0
    },
    {
      "step_id": 7, "op": "collect",
      "args": {},
      "verify": {"mode": "element", "selector": "[data-e2e='video-player-collect']", "timeout": 10},
      "on_fail": "skip",
      "wait_after": 1
    },
    {
      "step_id": 8, "op": "next_video",
      "args": {},
      "wait_after": 2
    },
    {
      "step_id": 9, "op": "wait_watch",
      "args": {"seconds": 10},
      "wait_after": 0
    },
    {
      "step_id": 10, "op": "like",
      "args": {},
      "verify": {"mode": "element", "selector": "[data-e2e='video-player-digg']", "timeout": 10},
      "on_fail": "skip",
      "wait_after": 1
    },
    {
      "step_id": 11, "op": "next_video",
      "args": {},
      "wait_after": 2
    },
    {
      "step_id": 12, "op": "wait_watch",
      "args": {"seconds": 8},
      "wait_after": 0
    }
  ]
}
