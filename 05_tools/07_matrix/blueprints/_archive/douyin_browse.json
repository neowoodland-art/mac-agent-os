{
  "id": "douyin_browse",
  "name": "抖音日常浏览",
  "platform": "douyin",
  "version": "1.0.0",
  "description": "浏览推荐页 + 随机点赞 + 评论，模拟真实用户行为",
  "steps": [
    {
      "op": "goto",
      "args": { "url": "https://www.douyin.com/follow" },
      "wait_after": 3,
      "wait_jitter": 1,
      "retry": 2
    },
    {
      "op": "remove_overlays",
      "args": {},
      "wait_after": 1
    },
    {
      "op": "wait",
      "args": { "seconds": 5 },
      "wait_after": 0
    },
    {
      "op": "swipe_up",
      "args": { "distance": 800, "duration_ms": 500 },
      "wait_after": 3,
      "wait_jitter": 1
    },
    {
      "op": "swipe_up",
      "args": { "distance": 800, "duration_ms": 400 },
      "wait_after": 8,
      "wait_jitter": 2
    },
    {
      "op": "evaluate",
      "args": {
        "script": "() => { const btn = document.querySelector('[class*=\"like\"]'); if (btn) btn.click(); }"
      },
      "wait_after": 2
    },
    {
      "op": "swipe_up",
      "args": { "distance": 800, "duration_ms": 450 },
      "wait_after": 12,
      "wait_jitter": 3
    },
    {
      "op": "swipe_up",
      "args": { "distance": 800, "duration_ms": 500 },
      "wait_after": 10,
      "wait_jitter": 2
    }
  ]
}
