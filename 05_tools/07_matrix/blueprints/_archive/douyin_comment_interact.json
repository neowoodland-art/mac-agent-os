{
  "id": "douyin_comment_interact",
  "name": "抖音评论互动",
  "platform": "douyin",
  "version": "1.0.0",
  "description": "浏览推荐→打开评论区→发评论→处理验证码→关闭评论",
  "entry_url": "https://www.douyin.com/",
  "entry_page": "recommend_feed",
  "steps": [
    {
      "step_id": 1, "op": "goto_home", "args": {},
      "wait_after": 3, "retry": 2,
      "post_check": "is_on_feed"
    },
    {
      "step_id": 2, "op": "wait_watch", "args": {"seconds": 8},
      "wait_after": 0, "wait_jitter": 3
    },
    {
      "step_id": 3, "op": "like", "args": {"probability": 0.5},
      "wait_after": 1
    },
    {
      "step_id": 4, "op": "open_comments", "args": {},
      "wait_after": 2
    },
    {
      "step_id": 5, "op": "post_comment", "args": {"text": "拍得真好"},
      "wait_after": 2, "on_verify": "cancel_and_continue"
    },
    {
      "step_id": 6, "op": "close_comments", "args": {},
      "wait_after": 1
    },
    {
      "step_id": 7, "op": "next_video", "args": {},
      "wait_after": 2
    },
    {
      "step_id": 8, "op": "wait_watch", "args": {"seconds": 10},
      "wait_after": 0, "wait_jitter": 3
    }
  ]
}
