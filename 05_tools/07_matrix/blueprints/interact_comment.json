{
  "id": "interact_comment",
  "name": "互动-定向评论",
  "description": "给指定视频发评论（含验证弹窗自动处理）",
  "version": "1.1",
  "platform": "douyin",
  "steps": [
    {"step_id": 1,  "op": "goto_url", "args": {"url": "@url"}, "pre": {}, "post": {}},
    {"step_id": 2,  "op": "wait_watch", "args": {"seconds": null}, "pre": {}, "post": {}},
    {"step_id": 3,  "op": "open_comments", "args": {}, "pre": {}, "post": {}},
    {"step_id": 4,  "op": "post_comment", "args": {"text": "@corpus"}, "pre": {}, "post": {}},
    {"step_id": 5,  "op": "auto_verify", "args": {}, "pre": {}, "post": {}},
    {"step_id": 6,  "op": "close_comments", "args": {}, "pre": {}, "post": {}}
  ],
  "args_schema": {
    "url": {"type": "string", "required": true, "desc": "目标视频链接"},
    "corpus": {"type": "string", "desc": "语料分类"}
  }
}
