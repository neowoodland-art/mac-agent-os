{
  "id": "interact_comment",
  "name": "互动-定向评论",
  "description": "给指定视频发评论（支持语料库取内容）",
  "version": "1.0",
  "platform": "douyin",
  "steps": [
    {"step_id": 1, "op": "goto_url", "args": {"url": "@url"}, "pre": {}, "post": {}},
    {"step_id": 2, "op": "wait_watch", "args": {"seconds": null}, "pre": {}, "post": {}},
    {"step_id": 3, "op": "open_comments", "args": {}, "pre": {}, "post": {}},
    {"step_id": 4, "op": "post_comment", "args": {"text": "@comment_text"}, "pre": {}, "post": {}},
    {"step_id": 5, "op": "close_comments", "args": {}, "pre": {}, "post": {}}
  ],
  "args_schema": {
    "url": {"type": "string", "required": true, "desc": "目标视频链接"},
    "comment_text": {"type": "string", "required": true, "desc": "评论内容，@corpus 从语料库取"}
  }
}
