#!/bin/bash
# mc — Matrix Console 快捷命令
# 统一 CLI 入口: 使用 00_setup/agentos 作为 agentos 包路径，调用 matrix 子命令
# 安装: chmod +x mc && sudo ln -s $(pwd)/mc /usr/local/bin/mc

_SRC="${BASH_SOURCE[0]}"
while [ -L "$_SRC" ]; do _SRC="$(readlink "$_SRC")"; done
SCRIPT_DIR="$(cd "$(dirname "$_SRC")" && pwd)"

PYTHON=""
if [ -n "$AGENTOS_PYTHON" ] && [ -x "$AGENTOS_PYTHON" ]; then
    PYTHON="$AGENTOS_PYTHON"
elif [ -f "$HOME/.workbuddy/binaries/python/envs/agent-os/bin/python3" ]; then
    PYTHON="$HOME/.workbuddy/binaries/python/envs/agent-os/bin/python3"
elif command -v python3 &>/dev/null; then
    PYTHON="python3"
else
    echo "找不到 Python 3，请设置 AGENTOS_PYTHON 环境变量" >&2
    exit 1
fi

# 使用统一 CLI: 00_setup/agentos 作为包路径
AGENTOS_PKG="$SCRIPT_DIR/../../00_setup/agentos"
if [ -d "$AGENTOS_PKG" ]; then
    cd "$SCRIPT_DIR/../../00_setup"
    exec "$PYTHON" -m agentos matrix "$@"
else
    # 降级: 使用 scripts/ 下的 agentos
    cd "$SCRIPT_DIR/scripts"
    exec "$PYTHON" -m agentos matrix "$@"
fi
