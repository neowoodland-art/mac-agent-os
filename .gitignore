# ==========================================
# AgentOS .gitignore
# 多机协作时，每个机器的专属文件应排除在外
# ==========================================

# -------- 系统文件 --------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# 虚拟环境
.venv/
venv/

# 运行时缓存（已软链接到 ~/agent-os-local/runtime_cache）
06_runtime/cache/

# 软链接目标文件不会被 Git 追踪，但以防万一排除大文件
*.mp4
*.mp3
*.mov
*.avi
*.mkv
*.wav
*.flac
*.zip
*.tar.gz
*.rar
*.7z

# 打包产物
07_migration/exports/

# 系统检查报告（临时文件）
system-check-report-*.md

# WorkBuddy 运行时（不属于仓库）
.codebuddy/
.workbuddy/

# ======== Obsidian 配置（各机器独立，不参与同步） ========
# workspace.json 记录窗口位置、打开的文件等，每台机器不同
# app.json/appearance.json 含插件配置、主题等，各机器独立
.obsidian/
!.obsidian/core-plugins.json  # 核心插件列表可同步（共享）
# ======================================================

# ======== 本机身份文件（从模板生成，各机器独立） ========
01_core/IDENTITY.md
01_core/HOST_ID.md
01_core/USER.md
# ======================================================

# 本地化MCP配置
01_core/mcp.json
01_core/mcp.tpl.json

# 本机记忆数据库（各机独立）
04_memory/long_term/facts.db

# 日志文件（各机独立）
04_memory/logs/*.log
04_memory/logs/*.log.*

# 软链接到 Obsidian 库的目录（不跟踪）
03_knowledge/01_daily/memory/

# Matrix 浏览器 Profile（每台机器独立，含 Cookie 和缓存）
05_tools/07_matrix/profiles/
05_tools/07_matrix/logs/
05_tools/07_matrix/scripts/archive/

# 本机 Matrix 路径配置（每台机器独立）
05_tools/07_matrix/local.yaml

# SMS 验证码配置（含API Key，每台机器独立）
05_tools/07_matrix/scripts/config/sms.yaml

# ======== longcat 爬虫（浏览器数据，不入库）========
05_tools/05_crawl/longcat/profiles/
05_tools/05_crawl/longcat/.local_packages/

# SMS 验证码配置（含API Key，每台机器独立）
05_tools/07_matrix/scripts/config/sms.yaml

# 配置备份
backup_*/
# 本机数据目录（不同步）
agent-local/
agent-os.code-workspace
04_memory/vector_db
06_runtime/
.obsidian/

# ======== 联邦运行时（各机器 guardd 自动生成）========
# 旧格式：按 hostname 命名的目录，各机器自生成，不同步
04_memory/cross_machine/status/*/heartbeat.json
# 新格式 v3：status/live/{uid}.json —— 需要同步到远程
# 注意不要用 "status/*/" 会连 live/ 一起排除
04_memory/cross_machine/events/
04_memory/cross_machine/knowledge/*.json
04_memory/cross_machine/tasks/

# ────── v4.2.0 新增排除项 ──────

# 图片文件（截图、素材，不入库）
*.png
*.jpg
*.jpeg
*.gif
*.webp

# ChromaDB 数据（各机独立）
chroma.sqlite3
**/chroma/

# 前端构建产物
node_modules/
dist/
build/

# ML 模型文件
*.pth
*.bin
*.onnx
*.npy
*.npz

# 运行时数据目录
04_memory/cross_machine/data/
04_memory/cross_machine/machines/

# Matrix 截图
05_tools/07_matrix/screenshots/

# AVE 输出
05_tools/09_ave/output/
05_tools/09_ave/cache/

# 系统报告归档
reports/

# Dashboard 前端产物
05_tools/10_dashboard/frontend/node_modules/
05_tools/10_dashboard/frontend/dist/

# Obsidian 插件（大文件 JS 不入库）
.obsidian/plugins/

# longcat 本地包（含 120MB Playwright node 二进制）
05_tools/05_crawl/longcat/.local_packages/
03_knowledge/01_submissions/*/

# 多机共享注册表（已迁移到 machines/*/ 方式，旧文件冲突不断，排除）
04_memory/cross_machine/status/live/_registry.json

# guardd 心跳数据 (已迁移到本机 local 目录, 不再提交 Gitee)
04_memory/cross_machine/data/
04_memory/cross_machine/status/live/
# Dashboard 构建产物（自动生成，不提交）
05_tools/10_dashboard/static/assets/
05_tools/10_dashboard/frontend/node_modules/
05_tools/10_dashboard/frontend/dist/
